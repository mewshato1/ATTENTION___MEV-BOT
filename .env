# ── BNB Chain ─────────────────────────────────────────────────────────
BSC_RPC_HTTP=
BSC_RPC_WS=

# ── Polygon ────────────────────────────────────────────────────────────
POLYGON_RPC_HTTP=https://polygon-rpc.com
POLYGON_RPC_WS=wss://polygon-bor-rpc.publicnode.com

# ── Arbitrum One ───────────────────────────────────────────────────────
ARBITRUM_RPC_HTTP=https://arb1.arbitrum.io/rpc
ARBITRUM_RPC_WS=wss://arbitrum-one-rpc.publicnode.com

# ── Avalanche C-Chain ──────────────────────────────────────────────────
AVAX_RPC_HTTP=https://api.avax.network/ext/bc/C/rpc
AVAX_RPC_WS=wss://avalanche-c-chain-rpc.publicnode.com

# ── КОШЕЛЁК ──────────────────────────────────────────────────────────
WALLET_ADDRESS=
PRIVATE_KEY=

# ── КОНТРАКТЫ ─────────────────────────────────────────────────────────
FLASH_CONTRACT_ADDRESS=
POLYGON_CONTRACT=
ARBITRUM_CONTRACT=
AVALANCHE_CONTRACT=

FLASH_PROVIDER=aave

# ── API ключи ──────────────────────────────────────────────────────────
BSCSCAN_API_KEY=
POLYGONSCAN_API_KEY=
ARBISCAN_API_KEY=
SNOWTRACE_API_KEY=

# ── РЕЖИМ РАБОТЫ ──────────────────────────────────────────────────────
DRY_RUN=false

# ── ПАРАМЕТРЫ ТОРГОВЛИ ────────────────────────────────────────────────
FLASH_MIN_PROFIT_BNB=0.0003
MAX_TRADE_BNB=0.1
MIN_PROFIT_BNB=0.0001
MAX_GAS_GWEI=10

# ── TELEGRAM ──────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALERTS=false
TG_ALERT_FAIL=false
LOG_LEVEL=DEBUG
GAS_LIMIT=300000
USE_OPTIMAL_SIZE=true
SCAN_MODE=block
SCAN_INTERVAL_SEC=0.5
MULTICALL_BATCH_SIZE=500
GAS_PRICE_MULT=1.5
