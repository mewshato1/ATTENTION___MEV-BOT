# =============================================================================
# .env.example — Скопируй в .env и заполни своими данными
# =============================================================================
# ВАЖНО: Никогда не коммить .env в git!
# Добавь .env в .gitignore
# =============================================================================

# --- Подключение к сети ---
BSC_RPC_HTTP=https://bsc-dataseed1.binance.org/
BSC_RPC_WS=wss://bsc-ws-node.nariox.org:443
# Для лучшей скорости используй платный RPC:
# BSC_RPC_HTTP=https://your-endpoint.quiknode.pro/YOUR_KEY/

# --- Кошелёк (ТОЛЬКО hot wallet для бота, не основной!) ---
WALLET_ADDRESS=0xYourWalletAddressHere
PRIVATE_KEY=YourPrivateKeyHere

# --- Режим работы ---
# true  = симуляция, деньги не тратятся (для тестирования)
# false = реальная торговля
DRY_RUN=true

# --- Параметры торговли ---
MIN_PROFIT_BNB=0.003
MAX_TRADE_BNB=0.5
SLIPPAGE_PCT=0.5

# --- Параметры газа ---
GAS_LIMIT=500000
GAS_PRICE_MULT=1.2
MAX_GAS_GWEI=10.0

# --- Сканирование ---
SCAN_INTERVAL_SEC=2.0

# --- Логирование ---
LOG_LEVEL=INFO
LOG_FILE=mev_bot.log
